  "cpp14_template": "#include <bits/stdc++.h>\nusing namespace std;\n\n\nstruct Node {\n    Node *next;\n    int data;\n};\n\n\nclass LinkedList{\n    public:\n    LinkedList(){\n        head = nullptr;\n        tail = nullptr;\n    }\n    ~LinkedList(){\n        Node* temp;\n        while(head != nullptr){\n            temp = head;\n            head = head->next;\n            delete temp;\n        }\n    }\n    void add(int value){\n        Node* temp = new Node;\n        temp->data = value;\n        temp->next = nullptr;\n        \n        if (head == nullptr and tail == nullptr){\n            head = tail = temp;\n        } else {\n            tail->next = temp;\n            tail = temp;\n        }\n    }\n    void print(){\n        Node* curr = head;\n        while(curr != nullptr){\n            cout << curr->data << \" \";\n            curr = curr->next;\n        }\n    }\n    \nprivate:\n    Node *head, *tail;\n};\n\nvoid solve(LinkedList& num1, LinkedList& num2){\n    // TODO: Implement this function\n    // Feel free to modify the template to your liking\n}\n\nint main(){\n    LinkedList num1, num2;\n\n    int size1, size2;\n    cin >> size1;\n    for(int i = 0 ; i < size1 ; i++){\n        int digit;\n        cin >> digit;\n        num1.add(digit);\n    }\n    \n    cin >> size2;\n    for(int i = 0 ; i < size2 ; i++){\n        int digit;\n        cin >> digit;\n        num2.add(digit);\n    }\n  \n    solve(num1, num2);\n}",
