  "java8_template": "import java.io.*;\nimport java.util.*;\nimport java.text.*;\n\npublic class Main {\n    \n    static class FastReader {\n        \n        private final BufferedReader br;\n        \n        private StringTokenizer st;\n\n        public FastReader() {\n            br = new BufferedReader(new InputStreamReader(System.in));\n        }\n\n        public String next() {\n            while (st == null || !st.hasMoreElements()) {\n                try {\n                    st = new StringTokenizer(br.readLine());\n                } catch (IOException ignored) { }\n            }\n            return st.nextToken();\n        }\n\n        public int nextInt() {\n            return Integer.parseInt(next());\n        }\n    }\n\n    static class LinkedList <T> {\n    \n        private Node first;\n        private Node last;\n        \n        public LinkedList() {\n            first = null;\n            last = null;\n        }\n\n        public void add(T value) {\n            \n            if (last == null) {\n                first = new Node(value, null);\n                last = first;\n                return;\n            }\n            \n            last.link = new Node(value, null);\n            last = last.link;\n        }\n\n        @Override\n        public String toString() {\n            StringBuilder result = new StringBuilder();\n\n            Node curr = this.first;\n            \n            while (curr != null) {\n                result.append(curr.value).append(\" \");\n                curr = curr.link;\n            }\n\n            return result.toString();\n        }\n        \n        private class Node {\n            T value;\n            Node link;\n\n            Node (T v, Node l) {\n                value = v;\n                link = l;\n            }\n        }\n    }\n    \n    public static void solve(LinkedList<Integer> num1, LinkedList<Integer> num2){\n        // TODO: Implement this method\n        // Feel free to modify the template to your liking\n    }\n\n    public static void main(String[] args) {\n        FastReader in = new FastReader();\n\n        LinkedList<Integer> num1 = new LinkedList<>();\n        LinkedList<Integer> num2 = new LinkedList<>();\n\n        int size1 = in.nextInt();\n        \n        for (int i = 0; i < size1; i++) {\n            num1.add(in.nextInt());\n        }\n        \n        int size2 = in.nextInt();\n        \n        for (int i = 0; i < size2; i++) {\n            num2.add(in.nextInt());\n        }\n        \n        solve(num1, num2);\n                \n    }\n}",
